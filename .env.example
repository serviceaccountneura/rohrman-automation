# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Port for any local server (optional)
PORT=3000

# ── Tekion Automotive Partner Cloud (APC) — official API path ────────────────
# Base URL has NO version suffix; per-endpoint versions go in the path.
# Sandbox:    https://api-sandbox.tekioncloud.com/openapi
# Production: https://api.tekioncloud.com/openapi
APC_BASE_URL=https://api-sandbox.tekioncloud.com/openapi
# From APC → My Applications → Generate App Credentials
APC_APP_ID=
APC_SECRET_KEY=
# From APC → Dealer Dashboard (sandbox sample dealer: techmotors_4_0)
APC_DEALER_ID=techmotors_4_0
# Optional: paste a token directly to skip auto-minting (debugging only)
APC_TOKEN=

# ── Tekion login (Playwright path: Purchase Order / Accounts Payable) ────────
TEKION_BASE_URL=https://app.tekioncloud.com
TEKION_USERNAME=
TEKION_PASSWORD=
# Authenticator seed used to generate the 6-digit login verification code
TEKION_TOTP_SECRET=

# Optional US proxy (the Tekion web app is US-only)
# Format: http://user:pass@host:port
US_PROXY=
