# Copy to .env and fill in. Never commit the result — .env is gitignored, and
# these are live credentials to Tekion, Google Cloud and a mail account.

# ── Database ─────────────────────────────────────────────────────────────────
# Local development:
#   postgresql+psycopg://rohrman:rohrman@localhost:5432/rohrman
#
# Production (RDS). Note the +psycopg driver — plain postgresql:// picks
# psycopg2, which is not installed and fails at startup with a driver error
# that points nowhere useful.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@your-instance.abcdefg.us-east-2.rds.amazonaws.com:5432/rohrman

# ── Auth ─────────────────────────────────────────────────────────────────────
# 64+ random characters. Different from the frontend's AUTH_SECRET: they sign
# different things, and sharing them means one leak compromises both.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access token lifetime. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Tekion ───────────────────────────────────────────────────────────────────
TEKION_USERNAME=
TEKION_PASSWORD=
# The TOTP seed, not a generated code — the client derives codes from it.
TEKION_TOTP_SECRET=

# ── S3 ───────────────────────────────────────────────────────────────────────
# Setting the bucket is what switches archiving on. Leave it empty and uploads
# stay on local disk only, which is fine for development and NOT fine on EC2:
# every deploy restarts the container, and anything queued at that moment
# loses its only copy.
S3_BUCKET=
AWS_REGION=us-east-2

# Leave the keys EMPTY on EC2 and attach an instance role instead. boto3 falls
# back to the role automatically, nothing long-lived sits on the box, and the
# credentials rotate themselves. The role needs, on this bucket only:
#   s3:PutObject, s3:GetObject, s3:DeleteObject  on arn:aws:s3:::BUCKET/*
#   s3:ListBucket                                on arn:aws:s3:::BUCKET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email (invitations) ──────────────────────────────────────────────────────
# Gmail needs an App Password, not the account password — 2-step verification
# on, then Security → App passwords. The normal password is rejected for SMTP.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=Rohrman Invoice Automation
# Only set this if it is a verified alias on the sending account; Gmail rewrites
# or rejects a From address it does not own.
SMTP_FROM_EMAIL=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where invitation links point. Must be the URL a browser uses — it is emailed
# to people outside the network, so a container name here sends them nowhere.
FRONTEND_URL=http://localhost:3000

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Threads reading documents in parallel. Multiplies peak memory: pages render
# at 300 DPI, roughly 24 MB each, and a ten-page invoice holds all of them at
# once. 2 is comfortable on a t3.medium.
PIPELINE_WORKERS=2

# ── Vertex AI ────────────────────────────────────────────────────────────────
# Path to the Google service-account JSON. Defaults to neura_vertex_ai.json in
# the project root; the container mounts it read-only at /app.
# VERTEX_CREDENTIALS=/app/neura_vertex_ai.json
