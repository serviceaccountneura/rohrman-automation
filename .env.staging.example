# Staging configuration — copy to .env.staging and fill in.
#
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
#
# Production reads .env and docker-compose.yml; these two files are the staging
# pair. Nothing is shared: staging brings its own Postgres and its own MinIO.

# ── Database: the Postgres in docker-compose.staging.yml, NOT the prod RDS ────
# Host "db" is the container. POSTGRES_PASSWORD must match the password here.
DATABASE_URL=postgresql+psycopg://rohrman:CHANGE_ME@db:5432/rohrman_de1_staging
POSTGRES_USER=rohrman
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rohrman_de1_staging

# ── Auth ─────────────────────────────────────────────────────────────────────
# Different from production's, so a token minted here is worthless there.
JWT_SECRET=                     # python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Tekion ───────────────────────────────────────────────────────────────────
# There is no Tekion sandbox. Whatever you put here is the account staging
# posts to, and a pre-invoice or journal entry it creates is real and has to be
# voided by a person inside Tekion. Leave blank to make that impossible.
TEKION_USERNAME=
TEKION_PASSWORD=
TEKION_TOTP_SECRET=

# ── S3: MinIO from docker-compose.staging.yml, not AWS ───────────────────────
# S3_ENDPOINT_URL is what makes boto3 talk to MinIO instead of Amazon, and
# path-style addressing goes with it (bucket.host only resolves for AWS).
#
# http://minio:9000 is the internal name: right for archiving, and for the
# restore-after-restart path. The invoice PREVIEW is fetched by the browser
# from the presigned URL, so to make that work put MinIO behind a hostname
# both the container and a laptop can reach, and set this to that — the
# signature covers the host, so both sides must use the same one.
S3_BUCKET=rohrman-invoices-staging
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=rohrman-staging
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_ENDPOINT_URL=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Where a BROWSER fetches a presigned invoice from, when that differs from the
# address the api itself uses. Signing is local arithmetic, so the two can
# differ: uploads and downloads keep using S3_ENDPOINT_URL and only the
# signature is computed against this one. Empty means "same as above", which
# is correct on real S3 and therefore in production.
#
# On staging this is MinIO's own hostname in front of :9000, e.g.
#   https://minio-staging-de1-rohrman-automotive.neuralogicgroup.com
# Whatever fronts it must forward the query string untouched -- the signature
# travels in X-Amz-* params -- and must not cache responses, or one person's
# signed URL would be served to the next.
S3_PUBLIC_ENDPOINT_URL=
MINIO_ROOT_USER=rohrman-staging
MINIO_ROOT_PASSWORD=CHANGE_ME       # same value as AWS_SECRET_ACCESS_KEY

# ── Outbound mail ────────────────────────────────────────────────────────────
# Blank means nothing is sent: invite and password-reset rows are still
# written, so read them out of the database, and a staging test cannot reach a
# real person's inbox. Filling these in makes staging mail REAL mail -- from
# whatever account you name here, into real inboxes.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=Rohrman Automotive (Staging)
SMTP_FROM_EMAIL=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where invite and reset links point: the staging frontend, not production's.
FRONTEND_URL=https://staging-de1-rohrman-automotive.neuralogicgroup.com

# One worker: the box runs six containers on 3.8 GB and OCR is the memory hog.
PIPELINE_WORKERS=1

GOOGLE_APPLICATION_CREDENTIALS=/app/neura_vertex_ai.json
