{
  "name": "tekion-apc-openapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure-code TypeScript wrappers for every Tekion APC endpoint available at the Open API tier.",
  "scripts": {
    "apc": "tsx src/apc.ts",
    "otp": "tsx src/totp.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "ex:vehicles": "tsx examples/vehicleBulkImport.ts",
    "ex:lead": "tsx examples/leadIntake.ts",
    "ex:customer": "tsx examples/customerSync.ts",
    "smoke": "tsx examples/apcSmokeTest.ts",
    "token": "tsx cli/token.ts",
    "customer:create": "tsx cli/createCustomer.ts",
    "customer:update": "tsx cli/updateCustomer.ts",
    "vehicles:list": "tsx cli/listVehicles.ts",
    "deal:accessory": "tsx cli/getDealAccessory.ts",
    "lead:update": "tsx cli/updateLead.ts",
    "pw:login": "tsx src/playwright/login.ts",
    "pw:capture": "tsx src/playwright/capture.ts",
    "pw:analyze": "tsx src/playwright/analyze.ts",
    "pw:capture:ap": "tsx src/playwright/captureApproval.ts",
    "pw:analyze:ap": "tsx src/playwright/analyzeApproval.ts",
    "pw:capture:je": "tsx src/playwright/captureJE.ts",
    "pw:analyze:je": "tsx src/playwright/analyzeJE.ts",
    "pw:capture:vso": "tsx src/playwright/captureVSO.ts",
    "pw:analyze:vso": "tsx src/playwright/analyzeVSO.ts",
    "pw:codegen": "playwright codegen --load-storage=tekion-auth.json https://app.tekioncloud.com/parts/purchase-order/list",
    "server": "tsx src/apcServer.ts",
    "dev": "tsx watch src/apcServer.ts",
    "apc-server": "tsx src/apcServer.ts",
    "api:sublet": "tsx src/api/subletFlow.ts",
    "api:misc": "tsx src/api/miscFlow.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
